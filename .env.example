# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local — มีใน .gitignore แล้ว)
# ค่าจริงขอจากผู้ดูแลระบบผ่านช่องทางส่วนตัว

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable key (เดิมเรียก anon key) — ใช้ฝั่งเบราว์เซอร์ได้ สิทธิ์ถูกคุมด้วย RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key (service role) — ฝั่ง server เท่านั้น ข้าม RLS ได้ทั้งหมด
# ใช้ลบผู้ใช้/ลบรูปของผู้ใช้อื่นในหน้าแอดมิน และสคริปต์ใน scripts/
SUPABASE_SECRET_KEY=

# ---- ระบบทำนาย OM/P/K จากภาพ (Azure Container Apps ของทีม AI) ----
# ฝั่ง server เท่านั้น — ห้ามเปลี่ยนชื่อเป็น NEXT_PUBLIC_*
MODEL_API_URL=https://<container-app>.azurecontainerapps.io
MODEL_API_KEY=

# scripts/import_boundaries.js ใช้ชื่อเดิมของ secret key
# SUPABASE_SERVICE_ROLE_KEY=
